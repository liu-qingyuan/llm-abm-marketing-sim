# exclusions live here. Durable README/manifest files remain searchable.

# Research runs and historical payloads.
/runs/
/archive/**
!/archive/
!/archive/*/
!/archive/*/README.md
!/archive/*/archive_manifest.json

/data/raw/*
!/data/raw/.gitkeep
!/data/raw/README.md
/data/processed/*
!/data/processed/.gitkeep
!/data/processed/README.md
!/data/processed/jinjiang_douyin/
/data/processed/jinjiang_douyin/*
!/data/processed/jinjiang_douyin/README.md

